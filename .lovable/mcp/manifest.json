{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "realty-choices-refined",
      "version": "0.1.0",
      "title": "Realty Choices Refined"
    },
    "tools": [
      {
        "name": "list_locations",
        "title": "List locations",
        "description": "List all Hyderabad micro-markets/localities covered by Hyderabad Realty Choices (e.g. Kokapet, Tellapur, Financial District), with their slugs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List residential projects with optional filters. Use location slugs from list_locations. Returns a compact summary for each project including its slug for get_project.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "location": {
              "description": "Location slug, e.g. 'kokapet'.",
              "type": "string"
            },
            "bhk": {
              "description": "Configuration filter, e.g. '3' or '3 BHK'.",
              "type": "string"
            },
            "status": {
              "description": "Construction status, e.g. 'ongoing', 'ready-to-move'.",
              "type": "string"
            },
            "featured": {
              "description": "Only featured projects.",
              "type": "boolean"
            },
            "q": {
              "description": "Free-text keyword.",
              "type": "string"
            },
            "per_page": {
              "description": "Max results (default 20).",
              "type": "number"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project details",
        "description": "Get full public details for one residential project by slug, including available flat inventory when published.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "description": "Project slug, e.g. 'alekhya-rise'."
            },
            "include_flats": {
              "description": "Include available flats/units (default true).",
              "type": "boolean"
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_site",
        "title": "Search the site",
        "description": "Search Hyderabad Realty Choices content by keyword, location, property type or budget. Returns matching projects and locations.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "q": {
              "description": "Keyword, e.g. 'lake view 3 bhk'.",
              "type": "string"
            },
            "location": {
              "description": "Location slug.",
              "type": "string"
            },
            "type": {
              "description": "Property type, e.g. 'apartment', 'villa'.",
              "type": "string"
            },
            "budget": {
              "description": "Budget bucket, e.g. '1-2cr'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
